FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json ./
COPY shared/package.json ./shared/
COPY client/package.json ./client/
COPY server/package.json ./server/
RUN npm install
COPY shared ./shared
COPY client ./client
RUN npm run build -w @spherio/shared
WORKDIR /app
EXPOSE 5173
CMD ["npm", "run", "dev", "-w", "@spherio/client", "--", "--host", "0.0.0.0", "--port", "5173"]
